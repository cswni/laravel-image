# Development Environment Configuration
# Copy this file to .env for local development

# ==============================================
# APPLICATION
# ==============================================
APP_ENV=local
APP_DEBUG=true
APP_MODE=api
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_URL=http://localhost:8080

# ==============================================
# DATABASE
# ==============================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ==============================================
# REDIS
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
BROADCAST_DRIVER=log

# ==============================================
# PHP OPTIMIZATION (Development)
# ==============================================
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_POST_MAX_SIZE=100M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_TIMEZONE=UTC

# ==============================================
# OPCACHE OPTIMIZATION (Development)
# ==============================================
# Enable OPcache even in development for better performance
PHP_OPCACHE_ENABLE=1
# Enable timestamp validation for auto-reload on file changes
# Set to 1 in development to detect code changes automatically
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1

# ==============================================
# FRANKENPHP OPTIMIZATION (Development)
# ==============================================
# Lower thread count for development
FRANKENPHP_NUM_THREADS=2

# Worker mode disabled in development for easier debugging
FRANKENPHP_WORKER_FILE=

# ==============================================
# LOGGING
# ==============================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==============================================
# MAIL
# ==============================================
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# DEBUGGING
# ==============================================
# Telescope
TELESCOPE_ENABLED=true

# Debugbar
DEBUGBAR_ENABLED=true

# ==============================================
# FILAMENT
# ==============================================
FILAMENT_FILESYSTEM_DISK=public

# ==============================================
# ADDITIONAL SERVICES
# ==============================================
# Add your specific configuration here

