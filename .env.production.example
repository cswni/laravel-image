# Production Environment Configuration
# Copy this file to .env for production deployment

# ==============================================
# APPLICATION
# ==============================================
APP_ENV=production
APP_DEBUG=false
APP_MODE=api
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_URL=https://yourdomain.com

# ==============================================
# DATABASE
# ==============================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=your_secure_password_here
DB_ROOT_PASSWORD=your_root_password_here

# ==============================================
# REDIS
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_DRIVER=log

# ==============================================
# PHP OPTIMIZATION
# ==============================================
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=60
PHP_POST_MAX_SIZE=100M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_TIMEZONE=UTC

# ==============================================
# OPCACHE OPTIMIZATION (Production)
# ==============================================
# Enable OPcache
PHP_OPCACHE_ENABLE=1
# Disable timestamp validation for maximum performance
# Set to 0 in production (requires container restart after code changes)
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0

# ==============================================
# FRANKENPHP OPTIMIZATION
# ==============================================
# Number of threads (adjust based on your server CPU cores)
# Recommended: 2x number of CPU cores
FRANKENPHP_NUM_THREADS=8

# Worker mode (uncomment to enable FrankenPHP worker mode)
# This keeps your Laravel app in memory for ultra-fast response times
FRANKENPHP_WORKER_FILE=/var/www/html/public/index.php

# ==============================================
# LOGGING
# ==============================================
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ==============================================
# MAIL
# ==============================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# FILAMENT
# ==============================================
FILAMENT_FILESYSTEM_DISK=public

# ==============================================
# ADDITIONAL SERVICES
# ==============================================
# Add your specific configuration here

