FROM dunglas/frankenphp:1-php8.5-bookworm

LABEL maintainer="Carlos Andres <descarlos2013@gmail.com>"
LABEL description="Optimized Laravel image with FrankenPHP"
LABEL version="2.0"

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1 \
    COMPOSER_MEMORY_LIMIT=-1 \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_MODE=api \
    PHP_OPCACHE_ENABLE=1 \
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0 \
    PHP_MEMORY_LIMIT=512M \
    PHP_MAX_EXECUTION_TIME=60 \
    PHP_POST_MAX_SIZE=100M \
    PHP_UPLOAD_MAX_FILESIZE=100M \
    PHP_TIMEZONE=UTC \
    FRANKENPHP_NUM_THREADS=8 \
    FRANKENPHP_MAX_REQUESTS=1000 \
    LOG_LEVEL=INFO

WORKDIR /var/www/html

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash nano vim htop mariadb-client procps tzdata ca-certificates \
    libzip-dev libpng-dev libonig-dev libxml2-dev libicu-dev zlib1g-dev \
    curl git unzip libfreetype6-dev libjpeg62-turbo-dev \
    libmagickwand-dev libpq-dev libwebp-dev libcurl4-openssl-dev \
    supervisor cron \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) \
        gd \
        pdo_mysql \
        pdo_pgsql \
        pgsql \
        zip \
        intl \
        pcntl \
        posix \
        exif \
        bcmath \
        opcache \
        sockets \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && (pecl install imagick && docker-php-ext-enable imagick) || echo "Imagick installation skipped" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/src/php*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY docker/php/php.ini /usr/local/etc/php/conf.d/php.ini

COPY ./Caddyfile /etc/caddy/Caddyfile

COPY docker/entrypoints/*.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

RUN ln -sf /usr/local/bin/default.optimized.sh /usr/local/bin/entrypoint

RUN echo "alias pa='cd /var/www/html && php artisan'" >> /etc/bash.bashrc \
    && echo "alias ts='cd /var/www/html && php artisan typescript:transform'" >> /etc/bash.bashrc \
    && echo "alias cu='cd /var/www/html && composer update'" >> /etc/bash.bashrc \
    && echo "alias ci='cd /var/www/html && composer install'" >> /etc/bash.bashrc \
    && echo "alias cda='cd /var/www/html && composer dump-autoload -o'" >> /etc/bash.bashrc \
    && echo "alias opt='cd /var/www/html && php artisan optimize'" >> /etc/bash.bashrc \
    && echo "alias optc='cd /var/www/html && php artisan optimize:clear'" >> /etc/bash.bashrc \
    && echo "alias mfs='cd /var/www/html && php artisan migrate:fresh --seed'" >> /etc/bash.bashrc \
    && echo "alias migrate='cd /var/www/html && php artisan migrate'" >> /etc/bash.bashrc \
    && echo "alias tinker='cd /var/www/html && php artisan tinker'" >> /etc/bash.bashrc \
    && echo "alias test='cd /var/www/html && php artisan test'" >> /etc/bash.bashrc \
    && echo "alias pint='cd /var/www/html && ./vendor/bin/pint'" >> /etc/bash.bashrc \
    && echo "alias phpstan='cd /var/www/html && ./vendor/bin/phpstan analyse'" >> /etc/bash.bashrc

RUN mkdir -p /tmp/opcache && chown -R www-data:www-data /tmp/opcache

RUN mkdir -p /var/www/html/storage /var/www/html/bootstrap/cache \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || curl -f http://localhost:8080/ || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint"]
