{
    auto_https off
    admin off

    frankenphp {
                   num_threads {$FRANKENPHP_NUM_THREADS:8}
                   worker {$FRANKENPHP_WORKER_FILE:}
               }

    order php_server before file_server
}

:8080 {
    root * /var/www/html/public

    encode {
               zstd
               br
               gzip
               minimum_length 256
           }

    header {
               X-Content-Type-Options nosniff
               X-Frame-Options SAMEORIGIN
               X-XSS-Protection "1; mode=block"
               Referrer-Policy strict-origin-when-cross-origin
               -Server
               -X-Powered-By
               Permissions-Policy "geolocation=(), microphone=(), camera=()"
           }

    route {
              try_files {path} /index.php

              php_server {
                             root /var/www/html/public
                             split .php
                             resolve_root_symlink
                         }
          }

    @static_assets {
                       file
                       path *.css *.js *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ttf *.eot *.otf *.webp *.avif *.map
                   }
    handle @static_assets {
                              header Cache-Control "public, max-age=31536000, immutable"
                              header Vary "Accept-Encoding"
                          }

    @build_assets {
                      path /build/* /assets/* /storage/app/public/*
                  }
    handle @build_assets {
                             header Cache-Control "public, max-age=31536000, immutable"
                             header Vary "Accept-Encoding"
                         }

    @html {
              file
              path *.html
          }
    handle @html {
                     header Cache-Control "no-cache, no-store, must-revalidate"
                     header Pragma "no-cache"
                     header Expires "0"
                 }

    @denied {
                path /.env* /.git/* /composer.json /composer.lock /package*.json *.md /artisan /storage/* !/storage/app/public/*
            }
    handle @denied {
                       respond 404
                   }

    @health {
                path /health /up
            }
    handle @health {
                       respond "OK" 200
                   }

    log {
            output stdout
            format console
            level {$LOG_LEVEL:INFO}
        }

    handle_errors {
                      @5xx expression `{http.error.status_code} >= 500 && {http.error.status_code} < 600`
                      handle @5xx {
                                      respond "Server Error" 500
                                  }

                      @4xx expression `{http.error.status_code} >= 400 && {http.error.status_code} < 500`
                      handle @4xx {
                                      respond "Not Found" 404
                                  }
                  }

    file_server {
                    hide .env* .git composer.json composer.lock package*.json *.md artisan
                }
}
