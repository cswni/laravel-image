{
    auto_https off
    admin off
}

:8080 {
    root * /var/www/html/public

    encode zstd gzip

    php_server

    file_server

    header {
        -Server
        -X-Powered-By
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format console
        level {$LOG_LEVEL:INFO}
    }
}

